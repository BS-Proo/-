<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>نظام مسحوبات الأصناف الشهرية</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>
<style>
:root{--bg:#f4f6fa;--card:#fff;--tx:#1b2433;--mu:#6b768a;--bd:#dfe4ee;--pr:#1d6fd8;--prt:#fff;--ok:#16874f;--wr:#b86e00;--er:#c0392b;--hd:#eef2f9;--box-sizing:border-box;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#10151f;--card:#18202e;--tx:#e6ebf5;--mu:#93a0b8;--bd:#2a3548;--pr:#5aa0ff;--prt:#07101f;--ok:#4cc38a;--wr:#e9a23b;--er:#ff7b6b;--hd:#1f2938}}
:root[data-theme="dark"]{--bg:#10151f;--card:#18202e;--tx:#e6ebf5;--mu:#93a0b8;--bd:#2a3548;--pr:#5aa0ff;--prt:#07101f;--ok:#4cc38a;--wr:#e9a23b;--er:#ff7b6b;--hd:#1f2938}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font-family:Cairo,Tahoma,Arial,sans-serif;font-size:14px;line-height:1.6}
.wrap{max-width:1200px;margin:0 auto;padding:16px}
h1{font-size:20px;margin:0 0 2px}.sub{color:var(--mu);margin:0 0 14px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:14px;margin-bottom:14px}
.card h2{font-size:15px;margin:0 0 10px;display:flex;align-items:center;gap:8px}
.n{background:var(--pr);color:var(--prt);width:22px;height:22px;border-radius:50%;display:inline-grid;place-items:center;font-size:12px}
.drop{border:2px dashed var(--bd);border-radius:10px;padding:22px;text-align:center;color:var(--mu);cursor:pointer;transition:.15s}
.drop.on,.drop:hover{border-color:var(--pr);color:var(--pr);background:var(--hd)}
button,select,input,textarea{font-family:inherit;font-size:13px;color:var(--tx);background:var(--card);border:1px solid var(--bd);border-radius:8px;padding:7px 10px}
button{cursor:pointer}button.p{background:var(--pr);color:var(--prt);border-color:var(--pr);font-weight:600}
button.g{background:transparent}button:hover{filter:brightness(.95)}
textarea{width:100%;min-height:70px;resize:vertical}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}@media(max-width:800px){.grid{grid-template-columns:1fr}}
.files{display:flex;flex-direction:column;gap:6px;margin-top:10px}
.f{display:flex;flex-wrap:wrap;gap:8px;align-items:center;border:1px solid var(--bd);border-radius:8px;padding:6px 10px;background:var(--hd)}
.f .nm{flex:1;min-width:160px;font-weight:600}.f small{color:var(--mu)}
.f input{width:150px}
.tag{font-size:11px;padding:1px 8px;border-radius:99px;background:var(--bd);color:var(--tx)}
.tag.w{background:var(--wr);color:#fff}
.list{max-height:240px;overflow:auto;border:1px solid var(--bd);border-radius:8px;margin-top:8px}
.list label{display:flex;gap:8px;padding:4px 10px;border-bottom:1px solid var(--bd);cursor:pointer;align-items:center}
.list label:hover{background:var(--hd)}.list b{color:var(--mu);font-weight:600;min-width:42px}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.chip{background:var(--hd);border:1px solid var(--bd);border-radius:99px;padding:2px 10px;font-size:12px;cursor:pointer}.chip:hover{border-color:var(--er)}
.msg{font-size:12px;color:var(--wr);margin-top:6px}
.tw{overflow-x:auto;border:1px solid var(--bd);border-radius:10px}
table{border-collapse:collapse;width:100%;min-width:560px}
th,td{padding:7px 10px;border-bottom:1px solid var(--bd);text-align:center;white-space:nowrap}
th{background:var(--hd);position:sticky;top:0;font-weight:700}
td.l,th.l{text-align:right}td.nm{white-space:normal;min-width:200px}
tfoot td{font-weight:700;background:var(--hd)}
td.t{font-weight:700}.z{color:var(--mu)}
.kp{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:12px}
.k{background:var(--hd);border-radius:10px;padding:10px 12px}.k span{color:var(--mu);font-size:12px}.k div{font-size:18px;font-weight:700}
.empty{text-align:center;color:var(--mu);padding:26px}
#toast{position:fixed;bottom:calc(16px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);background:var(--tx);color:var(--bg);padding:8px 16px;border-radius:99px;display:none;z-index:9}
.xl{direction:ltr;max-height:70vh;overflow:auto;border:1px solid #4472c4}
.xl table{font-family:Arial,Cairo,sans-serif;font-size:13px;min-width:0;width:auto}
.xl th{background:var(--card);border:1px solid #4472c4;border-bottom:2px solid #4472c4;font-weight:700;white-space:normal;min-width:84px;max-width:118px;height:58px;vertical-align:middle;line-height:1.3;z-index:2}
.xl td{border:1px solid #4472c4;height:25px;padding:2px 8px}
.xl tbody tr:nth-child(odd) td{background:rgba(68,114,196,.16)}
.xl th:nth-child(1){min-width:110px}.xl th:nth-child(2){min-width:150px}
.xl td:nth-child(2){white-space:normal}
#tabs button{border-radius:8px 8px 0 0}
</style>
</head>
<body>
<div class="wrap">
<h1>📦 نظام مسحوبات الأصناف الشهرية</h1>
<p class="sub">ارفع تقارير "مبيعات الصنف" لأي عدد عملاء وشهور، اختار الأصناف، واطلع الجدول الشهري جاهز للإكسل.</p>

<div class="card"><h2><span class="n">1</span>رفع التقارير</h2>
<div class="drop" id="drop">اسحب ملفات الإكسل هنا أو اضغط للاختيار (ممكن أكتر من ملف)</div>
<input type="file" id="fi" accept=".xlsx,.xls" multiple hidden>
<div class="files" id="files"></div></div>

<div class="card"><h2><span class="n">2</span>اختيار الأصناف</h2>
<div class="grid"><div>
<textarea id="paste" placeholder="الصق أكواد أو أجزاء من أسماء الأصناف (واحد في كل سطر أو بفاصلة)"></textarea>
<div class="row" style="margin-top:6px"><button class="p" id="addp">إضافة للقائمة</button><button class="g" id="clr">مسح الكل</button></div>
<div class="msg" id="nf"></div></div>
<div><input id="q" placeholder="🔍 ابحث (مثلاً: باهي) في أصناف التقارير المرفوعة" style="width:100%">
<div class="row" style="margin-top:6px"><label>الوزن <select id="wc"><option value="all">كل الأوزان</option><option value="small">أوزان صغيرة</option><option value="large">أوزان كبيرة</option></select></label><label>الفاصل <input id="wcut" type="number" min="1" style="width:80px"> جم</label></div>
<div class="row" style="margin-top:6px"><button class="g" id="selv">تحديد الظاهر</button><span class="z" id="cnt"></span></div>
<div class="list" id="list"></div></div></div>
<div class="chips" id="chips"></div></div>

<div class="card"><h2><span class="n">3</span>النتيجة</h2>
<div class="row" style="margin-bottom:12px">
<label>العميل <select id="cust"></select></label>
<label>المقياس <select id="metric"><option value="qty">مباع كمية</option><option value="qb">مباع + بونص</option><option value="bonus">بونص عيني</option><option value="net">صافي البيع (ج)</option></select></label>
<label>الترتيب <select id="mode"><option value="tot">حسب الإجمالي ↓</option><option value="name">حسب اسم العميل</option><option value="orig">كما في التقرير</option></select></label>
<label>ترتيب الأوزان <select id="wsort"><option value="desc">من الكبير للصغير</option><option value="asc">من الصغير للكبير</option><option value="none">حسب ترتيب الاختيار</option></select></label>
<label style="display:flex;align-items:center;gap:6px"><input type="checkbox" id="wm"> دمج الأوزان المتساوية</label>
<span style="flex:1"></span><button id="cp" class="g">نسخ</button><button id="ex" class="p">⬇ تصدير Excel</button></div>
<div class="row" id="mf" style="margin-bottom:12px"></div><div id="kp" class="kp"></div><div id="tabs" class="row" style="margin-bottom:0"></div><div id="out"></div></div>
</div>
<div id="toast"></div>

<script>
const $=s=>document.querySelector(s);
const MN=['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];
let S={files:[],tracked:[],metric:'qty',cust:'__all',mode:'comb',hid:[]};
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const fmt=v=>(+v).toLocaleString('en-US',{maximumFractionDigits:2});
function toast(t){const e=$('#toast');e.textContent=t;e.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(()=>e.style.display='none',3200)}
function save(){try{localStorage.setItem('wd_state',JSON.stringify(S))}catch(e){}}
function load(){try{const x=JSON.parse(localStorage.getItem('wd_state')||'null');if(x&&x.files)S=Object.assign(S,x)}catch(e){}}

/* ---------- parsing ---------- */
function pdate(s){const m=String(s||'').match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);return m?new Date(+m[3],+m[2]-1,+m[1]):null}
const iso=d=>d?`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`:'';
const dmy=d=>d?`${d.getDate()}/${d.getMonth()+1}/${d.getFullYear()}`:'?';
function parseSheet(ws,fname){
  const R=XLSX.utils.sheet_to_json(ws,{header:1,defval:null});
  if(R.length<8)return null;
  if(R.some(r=>r&&String(r[1]||'').trim().startsWith('الكود')))return parseDisc(R,fname);
  const hdr=R[6]||[];
  const starts=[];hdr.forEach((h,j)=>{if(j>=2&&String(h||'').trim().startsWith('مباع'))starts.push(j)});
  if(!starts.length)return null;
  const to=pdate((R[1]||[])[3]),from=pdate((R[1]||[])[4]);
  const blocks=starts.map(j=>{let nm=null;for(let k=j;k<j+5;k++){const v=(R[4]||[])[k];if(v!=null&&String(v).trim()){nm=String(v).trim();break}}
    return{j,name:nm||'عميل',code:String((R[5]||[])[j]??'').trim(),tot:/^ا?لإ?جمالي|^اجمالي|^إجمالي/.test(nm||'')}});
  let use=blocks.filter(b=>!b.tot);if(!use.length)use=blocks;
  const customers=use.map(b=>({name:b.name,code:b.code,items:[]}));
  for(let r=7;r<R.length;r++){const row=R[r];if(!row||row[0]==null)continue;
    const code=String(row[0]).trim();if(code.includes('جمالي'))break;
    use.forEach((b,i)=>{const q=+row[b.j]||0,bo=+row[b.j+1]||0,net=+row[b.j+4]||0;
      if(q||bo||net)customers[i].items.push({code,name:String(row[1]||'').trim(),qty:q,bonus:bo,net})})}
  let label,multi=false;
  if(from&&to&&from.getMonth()===to.getMonth()&&from.getFullYear()===to.getFullYear())label=`${MN[from.getMonth()]} ${from.getFullYear()}`;
  else if(from&&to){label=`${dmy(from)} → ${dmy(to)}`;multi=true}
  else{label=fname.replace(/\.xlsx?$/i,'');multi=true}
  return{id:Date.now()+Math.random(),name:fname,label,from:iso(from),to:iso(to),multi,customers};
}
async function addFiles(list){
  let ok=0;
  for(const f of list){try{
    const wb=XLSX.read(await f.arrayBuffer(),{type:'array'});
    for(const sn of wb.SheetNames){const p=parseSheet(wb.Sheets[sn],f.name);if(p){S.files.push(p);ok++}}
  }catch(e){toast('تعذر قراءة '+f.name)}}
  if(ok){toast(`تم تحميل ${ok} تقرير`);renderAll()}else toast('مفيش شكل تقرير مبيعات الصنف متعرف عليه');
}

/* ---------- data helpers ---------- */
const val=it=>S.metric==='qty'?it.qty:S.metric==='bonus'?it.bonus:S.metric==='net'?it.net:it.qty+it.bonus;
const custNames=()=>[...new Set(S.files.flatMap(f=>f.customers.map(c=>c.name)))];
function labels(){const m={};S.files.forEach(f=>{const k=f.label;if(!(k in m)||f.from<m[k])m[k]=f.from});
  return Object.keys(m).sort((a,b)=>(m[a]||'').localeCompare(m[b]||'')||a.localeCompare(b))}
function allItems(){const m=new Map();S.files.forEach(f=>f.customers.forEach(c=>c.items.forEach(i=>{if(!m.has(i.code))m.set(i.code,i.name)})));
  return [...m].map(([code,name])=>({code,name})).sort((a,b)=>a.code.localeCompare(b.code,undefined,{numeric:true}))}
function agg(){
  const tr=new Set(S.tracked),m={};
  S.files.forEach(f=>f.customers.forEach(c=>{
    if(S.cust!=='__all'&&c.name!==S.cust)return;
    c.items.forEach(it=>{if(!tr.has(it.code))return;
      const key=S.mode==='split'?c.name+'|'+it.code:it.code;
      const o=m[key]||(m[key]={code:it.code,name:it.name,cust:c.name,v:{}});
      o.v[f.label]=(o.v[f.label]||0)+val(it)})}));
  // keep tracked order, include tracked items with no data
  const rows=[];
  S.tracked.forEach(code=>{
    const ks=Object.keys(m).filter(k=>m[k].code===code);
    if(ks.length)ks.sort().forEach(k=>rows.push(m[k]));
    else{const it=allItems().find(x=>x.code===code);rows.push({code,name:it?it.name:'',cust:'—',v:{}})}});
  return rows;
}

/* ---------- render ---------- */
function renderFiles(){
  $('#files').innerHTML=S.files.map((f,i)=>`<div class="f"><span class="nm">${esc(f.name)}<br><small>${f.customers.map(c=>esc(c.name)).join('، ')} · ${f.customers.reduce((a,c)=>a+c.items.length,0)} صنف</small></span>
  ${f.multi?'<span class="tag w" title="الفترة أكتر من شهر - ارفع تقرير لكل شهر">فترة مش شهر واحد</span>':''}
  <input value="${esc(f.label)}" data-i="${i}" class="lb" title="اسم الشهر/الفترة (الملفات بنفس الاسم بتتجمع)">
  <button class="g" data-del="${i}">✕</button></div>`).join('');
}
function renderPick(){
  const q=$('#q').value.trim().toLowerCase(),tr=new Set(S.tracked);
  const L=allItems().filter(i=>!q||i.code.includes(q)||i.name.toLowerCase().includes(q));
  window._vis=L;
  $('#list').innerHTML=L.length?L.slice(0,400).map(i=>`<label><input type="checkbox" data-c="${esc(i.code)}" ${tr.has(i.code)?'checked':''}><b>${esc(i.code)}</b><span>${esc(i.name)}</span></label>`).join(''):'<div class="empty">ارفع تقرير الأول</div>';
  $('#cnt').textContent=`${S.tracked.length} صنف مختار`;
  $('#chips').innerHTML=S.tracked.map(c=>`<span class="chip" data-rm="${esc(c)}">${esc(c)} ✕</span>`).join('');
}
function vis(){return labels().filter(l=>!(S.hid||[]).includes(l))}
function renderMonths(){const L=labels(),h=S.hid||[];
  $('#mf').innerHTML=L.length?'<b>الشهور:</b>'+L.map(l=>`<label class="chip" style="${h.includes(l)?'opacity:.45':'background:var(--pr);color:var(--prt)'}"><input type="checkbox" data-m="${esc(l)}" ${h.includes(l)?'':'checked'} hidden>${esc(l)}</label>`).join('')+'<button class="g" id="ma">الكل</button><button class="g" id="mn">مسح</button>':'';}
function renderCust(){
  const cs=custNames();if(S.cust!=='__all'&&!cs.includes(S.cust))S.cust='__all';
  $('#cust').innerHTML='<option value="__all">كل العملاء (مجمّع)</option>'+cs.map(c=>`<option ${c===S.cust?'selected':''} value="${esc(c)}">${esc(c)}</option>`).join('');
  $('#metric').value=S.metric;$('#mode').value=S.mode;
}
function renderOut(){
  const L=vis(),rows=agg(),split=S.mode==='split';
  if(!rows.length||!L.length){$('#out').innerHTML='<div class="empty">اختار أصناف بعد ما ترفع التقارير عشان يظهر الجدول</div>';$('#kp').innerHTML='';return}
  const colT=L.map(l=>rows.reduce((a,r)=>a+(r.v[l]||0),0)),grand=colT.reduce((a,b)=>a+b,0);
  const best=colT.indexOf(Math.max(...colT));
  $('#kp').innerHTML=`<div class="k"><span>الإجمالي</span><div>${fmt(grand)}</div></div><div class="k"><span>متوسط الشهر</span><div>${fmt(grand/L.length)}</div></div><div class="k"><span>أعلى شهر</span><div>${esc(L[best])}</div></div><div class="k"><span>عدد الأصناف</span><div>${S.tracked.length}</div></div>`;
  const mx=r=>Math.max(...L.map(l=>r.v[l]||0),1);
  let h=`<div class="tw"><table><thead><tr>${split?'<th class="l">العميل</th>':''}<th>الكود</th><th class="l">الصنف</th>${L.map(l=>`<th>${esc(l)}</th>`).join('')}<th>الإجمالي</th><th>المتوسط</th><th>%</th></tr></thead><tbody>`;
  rows.forEach(r=>{const t=L.reduce((a,l)=>a+(r.v[l]||0),0),m=mx(r);
    h+=`<tr>${split?`<td class="l">${esc(r.cust)}</td>`:''}<td>${esc(r.code)}</td><td class="l nm">${esc(r.name)}</td>${L.map(l=>{const x=r.v[l];return x==null?'<td class="z">–</td>':`<td style="background:rgba(29,111,216,${(.04+.2*x/m).toFixed(2)})">${fmt(x)}</td>`}).join('')}<td class="t">${fmt(t)}</td><td>${fmt(t/L.length)}</td><td class="z">${grand?(t/grand*100).toFixed(1):0}%</td></tr>`});
  h+=`</tbody><tfoot><tr><td colspan="${split?3:2}" class="l">الإجمالي</td>${colT.map(x=>`<td>${fmt(x)}</td>`).join('')}<td>${fmt(grand)}</td><td>${fmt(grand/L.length)}</td><td>100%</td></tr></tfoot></table></div>`;
  $('#out').innerHTML=h;
}
function renderAll(){renderFiles();renderCust();renderPick();renderMonths();renderOut();save()}

/* ---------- export ---------- */
function matrix(){
  const L=vis(),rows=agg(),split=S.mode==='split',o=split?1:0;
  const head=[...(split?['العميل']:[]),'الكود','الصنف',...L,'الإجمالي','المتوسط'];
  const A=[head];
  rows.forEach(r=>A.push([...(split?[r.cust]:[]),r.code,r.name,...L.map(l=>r.v[l]||0)]));
  return{A,L,o,n:rows.length};
}
async function exportX(){
  if(!S.tracked.length){toast('اختار أصناف الأول');return}
  const{A,L,o,n}=matrix(),c0=2+o,c1=c0+L.length-1,cs=XLSX.utils.encode_col;
  const ws=XLSX.utils.aoa_to_sheet(A);
  for(let r=1;r<=n;r++){
    const sum=A[r].slice(c0,c1+1).reduce((a,b)=>a+b,0);
    ws[cs(c1+1)+(r+1)]={t:'n',f:`SUM(${cs(c0)}${r+1}:${cs(c1)}${r+1})`,v:sum};
    ws[cs(c1+2)+(r+1)]={t:'n',f:`AVERAGE(${cs(c0)}${r+1}:${cs(c1)}${r+1})`,v:sum/L.length};
  }
  const tr=n+2;ws[cs(c0-1)+tr]={t:'s',v:'الإجمالي'};
  for(let c=c0;c<=c1+1;c++){let s=0;for(let r=1;r<=n;r++){const x=A[r][c];s+=(typeof x==='number'?x:A[r].slice(c0,c1+1).reduce((a,b)=>a+b,0))}
    ws[cs(c)+tr]={t:'n',f:`SUM(${cs(c)}2:${cs(c)}${n+1})`,v:s}}
  ws['!ref']=`A1:${cs(c1+2)}${tr}`;
  ws['!cols']=[...Array(c0).keys()].map(i=>({wch:i===c0-1?38:12})).concat(L.map(()=>({wch:14})),[{wch:14},{wch:14}]);
  ws['!views']=[{rightToLeft:true}];
  const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,'المسحوبات');
  const data=XLSX.write(wb,{type:'array',bookType:'xlsx'});
  try{const d=window.claude&&await window.claude.use('downloads');
    if(!d){toast('التصدير مش متاح هنا - استخدم زر نسخ');return}
    await d.save({filename:'مسحوبات_الأصناف.xlsx',data});
  }catch(e){if(e&&e.code!=='declined')toast('تعذر التصدير')}
}
async function copyT(){
  const{A}=matrix();if(A.length<2){toast('مفيش بيانات');return}
  try{await navigator.clipboard.writeText(A.map(r=>r.join('\t')).join('\n'));toast('اتنسخ - الصقه في الإكسل')}catch(e){toast('المتصفح منع النسخ')}
}

/* ---------- events ---------- */
const drop=$('#drop'),fi=$('#fi');
drop.onclick=()=>fi.click();fi.onchange=()=>{addFiles([...fi.files]);fi.value=''};
['dragover','dragenter'].forEach(e=>drop.addEventListener(e,ev=>{ev.preventDefault();drop.classList.add('on')}));
['dragleave','drop'].forEach(e=>drop.addEventListener(e,ev=>{ev.preventDefault();drop.classList.remove('on')}));
drop.addEventListener('drop',ev=>addFiles([...ev.dataTransfer.files]));
$('#files').addEventListener('input',e=>{if(e.target.classList.contains('lb')){S.files[+e.target.dataset.i].label=e.target.value.trim()||'—';renderMonths();renderOut();save()}});
$('#files').addEventListener('click',e=>{const i=e.target.dataset.del;if(i!=null){S.files.splice(+i,1);renderAll()}});
$('#q').oninput=renderPick;
$('#list').addEventListener('change',e=>{const c=e.target.dataset.c;if(c==null)return;
  const i=S.tracked.indexOf(c);if(e.target.checked&&i<0)S.tracked.push(c);else if(!e.target.checked&&i>=0)S.tracked.splice(i,1);renderPick();renderOut();save()});
$('#selv').onclick=()=>{(window._vis||[]).forEach(i=>{if(!S.tracked.includes(i.code))S.tracked.push(i.code)});renderPick();renderOut();save()};
$('#chips').addEventListener('click',e=>{const c=e.target.dataset.rm;if(c!=null){S.tracked=S.tracked.filter(x=>x!==c);renderPick();renderOut();save()}});
$('#clr').onclick=()=>{S.tracked=[];$('#nf').textContent='';renderPick();renderOut();save()};
$('#addp').onclick=()=>{
  const toks=$('#paste').value.split(/[\n,;،\t]+/).map(s=>s.trim()).filter(Boolean),items=allItems(),nf=[];
  toks.forEach(t=>{const tl=t.toLowerCase();let hit=items.filter(i=>i.code===t);
    if(!hit.length)hit=items.filter(i=>i.name.toLowerCase().includes(tl));
    if(!hit.length)nf.push(t);hit.forEach(h=>{if(!S.tracked.includes(h.code))S.tracked.push(h.code)})});
  $('#nf').textContent=nf.length?'مش لاقي: '+nf.join(' ، '):'';
  if(!items.length)toast('ارفع تقرير الأول');
  $('#paste').value='';renderPick();renderOut();save()};
$('#cust').onchange=e=>{S.cust=e.target.value;renderOut();save()};
$('#metric').onchange=e=>{S.metric=e.target.value;renderOut();save()};
$('#mode').onchange=e=>{S.mode=e.target.value;renderOut();save()};
$('#ex').onclick=exportX;$('#cp').onclick=copyT;
$('#mf').addEventListener('change',e=>{const m=e.target.dataset.m;if(m==null)return;S.hid=S.hid||[];const i=S.hid.indexOf(m);if(e.target.checked&&i>=0)S.hid.splice(i,1);else if(!e.target.checked&&i<0)S.hid.push(m);renderMonths();renderOut();save()});
$('#mf').addEventListener('click',e=>{if(e.target.id==='ma')S.hid=[];else if(e.target.id==='mn')S.hid=labels();else return;renderMonths();renderOut();save()});
/* ===== شكل شيت الشهر: عملاء (صفوف) × أصناف (أعمدة) ===== */
const TOT='الجمالي';
function tabs(){const L=vis();return L.length>1?[...L,'__all']:L}
function curTab(){const t=tabs();if(!t.includes(S.tab))S.tab=t[0];return S.tab}
function nfmt(){return S.metric==='net'?'_(* #,##0.00_);_(* \\(#,##0.00\\);_(* "-"??_);_(@_)':'_(* #,##0_);_(* \\(#,##0\\);_(* "-"??_);_(@_)'}
/* ===== تقرير "مبيعات الاصناف بالخصم": كل عميل في بلوك رأسي ===== */
function parseDisc(R,fname){
  const to=pdate((R[1]||[])[3]),from=pdate((R[1]||[])[4]),n2=s=>String(s??'').replace(/\s+/g,' ').trim();
  const customers=[];let cur=null,col=null;
  for(const row of R){if(!row)continue;
    if(n2(row[1]).startsWith('الكود')){cur={name:n2(row[2])||'عميل',code:n2(row[0]),items:[]};customers.push(cur);col=null;continue}
    if(!cur)continue;
    const hi=row.findIndex(v=>n2(v)==='اسم الصنف');
    if(hi>=0){const ix=t=>row.findIndex(v=>t.test(n2(v)));
      col={name:hi,code:ix(/^كود الصنف/),qty:ix(/^الكمي/),bonus:ix(/^بونص/),net:ix(/المبيعات/)};continue}
    if(!col||col.code<0)continue;
    const code=row[col.code];if(code==null||n2(code)==='')continue;
    cur.items.push({code:String(code).trim(),name:n2(row[col.name]),qty:col.qty>=0?+row[col.qty]||0:0,bonus:col.bonus>=0?+row[col.bonus]||0:0,net:col.net>=0?+row[col.net]||0:0})}
  if(!customers.length)return null;
  let label,multi=false;
  if(from&&to&&from.getMonth()===to.getMonth()&&from.getFullYear()===to.getFullYear())label=`${MN[from.getMonth()]} ${from.getFullYear()}`;
  else if(from&&to){label=`${dmy(from)} → ${dmy(to)}`;multi=true}
  else{label=fname.replace(/\.xlsx?$/i,'');multi=true}
  return{id:Date.now()+Math.random(),name:fname,label,from:iso(from),to:iso(to),multi,customers};
}
function build0(key){
  const L=key==='__all'?vis():[key],tr=S.tracked,nm={};allItems().forEach(i=>nm[i.code]=i.name);
  const cols=tr.map(c=>({code:c,name:nm[c]||c})),m=new Map();
  S.files.forEach(f=>{if(!L.includes(f.label))return;f.customers.forEach(c=>{
    if(S.cust!=='__all'&&c.name!==S.cust)return;
    const k=c.code+'|'+c.name;let o=m.get(k);if(!o){o={code:c.code,name:c.name,v:tr.map(()=>0),i:m.size};m.set(k,o)}
    c.items.forEach(it=>{const j=tr.indexOf(it.code);if(j>=0)o.v[j]+=val(it)})})});
  const rows=[...m.values()];rows.forEach(r=>r.t=r.v.reduce((a,b)=>a+b,0));
  if(S.mode==='tot')rows.sort((a,b)=>b.t-a.t||a.i-b.i);else if(S.mode==='name')rows.sort((a,b)=>a.name.localeCompare(b.name,'ar'));
  return{cols,rows};
}
function renderTabs(){const t=tabs(),c=curTab();$('#tabs').innerHTML=t.map(k=>`<button class="${k===c?'p':'g'}" data-t="${esc(k)}">${k==='__all'?'الإجمالي (كل الشهور)':esc(k)}</button>`).join('')}
function renderOut(){
  renderTabs();const k=curTab();
  if(!k||!S.tracked.length){$('#out').innerHTML='<div class="empty">ارفع التقارير واختار الأصناف عشان يظهر الجدول</div>';$('#kp').innerHTML='';return}
  const{cols,rows}=build(k),tot=rows.reduce((a,r)=>a+r.t,0);
  $('#kp').innerHTML=`<div class="k"><span>عدد العملاء</span><div>${rows.length}</div></div><div class="k"><span>إجمالي المسحوبات</span><div>${fmt(tot)}</div></div><div class="k"><span>عدد الأصناف</span><div>${cols.length}</div></div>`;
  const f=v=>!v?'-':v<0?`(${fmt(-v)})`:fmt(v);
  let h=`<div class="xl"><table><thead><tr><th>كود العميل</th><th>أسم العميل</th>${cols.map(c=>`<th title="${esc(c.code)}">${esc(c.name)}</th>`).join('')}<th>${TOT}</th></tr></thead><tbody>`;
  rows.forEach(r=>{h+=`<tr><td>${esc(r.code)}</td><td>${esc(r.name)}</td>${r.v.map(x=>`<td>${f(x)}</td>`).join('')}<td><b>${f(r.t)}</b></td></tr>`});
  $('#out').innerHTML=h+'</tbody></table></div>';
}
async function exportX(){
  if(!S.tracked.length){toast('اختار أصناف الأول');return}
  const t=tabs();if(!t.length){toast('مفيش شهور');return}
  if(!window.ExcelJS){toast('مكتبة التصدير مش متحملة');return}
  const wb=new ExcelJS.Workbook(),used=new Set(),F=nfmt(),esc2=s=>s.replace(/([[\]#'])/g,`'$1`);
  t.forEach((k,ti)=>{
    const{cols,rows}=build(k),n=rows.length,tn='Table'+(ti+1);
    let sn=(k==='__all'?'الإجمالي':k).replace(/[\\/?*[\]:]/g,' ').slice(0,31);
    while(used.has(sn.toLowerCase()))sn=sn.slice(0,28)+'_'+ti;used.add(sn.toLowerCase());
    const ws=wb.addWorksheet(sn),seen=new Set(['كود العميل','أسم العميل',TOT]);
    const hd=cols.map(c=>{const b=(c.name||c.code).replace(/[\r\n]+/g,' ').trim();let x=b,i=2;while(seen.has(x))x=b+' ('+(i++)+')';seen.add(x);return x});
    const lc=2+hd.length+1,names=['كود العميل','أسم العميل',...hd,TOT];
    if(n)ws.addTable({name:tn,ref:'A1',headerRow:true,totalsRow:false,
      style:{theme:'TableStyleLight16',showRowStripes:true,showFirstColumn:false,showLastColumn:false,showColumnStripes:false},
      columns:names.map(name=>({name})),rows:rows.map(r=>[r.code,r.name,...r.v,r.t])});
    else ws.addRow(names);
    for(let r=0;r<n;r++)ws.getCell(r+2,lc).value={formula:`SUM(${tn}[[#This Row],[${esc2(hd[0])}]:[${esc2(hd[hd.length-1])}]])`,result:rows[r].t};
    ws.getColumn(1).width=15.5;ws.getColumn(2).width=23.06;for(let c=3;c<=lc;c++)ws.getColumn(c).width=10.65;
    for(let r=1;r<=n+1;r++){const row=ws.getRow(r);row.height=r===1?58.5:24.95;
      for(let c=1;c<=lc;c++){const cell=row.getCell(c);
        cell.font={name:'Arial',size:10,color:{argb:'FF000000'}};
        cell.alignment={horizontal:'center',vertical:'center',wrapText:true};
        if(r>1)cell.numFmt=c<=2?'#,##0.00_);(#,##0.00)':F}}
  });
  const data=await wb.xlsx.writeBuffer();
  try{const d=window.claude&&await window.claude.use('downloads');
    if(!d){toast('التصدير مش متاح هنا - استخدم زر نسخ');return}
    await d.save({filename:'مسحوبات_الأصناف.xlsx',data});
  }catch(e){if(e&&e.code!=='declined')toast('تعذر التصدير')}
}
async function copyT(){
  const k=curTab();if(!k||!S.tracked.length){toast('مفيش بيانات');return}
  const{cols,rows}=build(k),A=[['كود العميل','أسم العميل',...cols.map(c=>c.name),TOT],...rows.map(r=>[r.code,r.name,...r.v,r.t])];
  try{await navigator.clipboard.writeText(A.map(r=>r.join('\t')).join('\n'));toast('اتنسخ - الصقه في الإكسل')}catch(e){toast('المتصفح منع النسخ')}
}
$('#tabs').addEventListener('click',e=>{const k=e.target.dataset.t;if(k==null)return;S.tab=k;renderOut();save()});
/* ===== فلتر الأوزان + ترتيب الأعمدة بالوزن + بحث يتجاهل ى/ي و ة/ه ===== */
const norm=s=>String(s||'').toLowerCase().replace(/[ىي]/g,'ي').replace(/[ةه]/g,'ه').replace(/[أإآٱ]/g,'ا').replace(/[\u064B-\u0652\u0640]/g,'');
function wOf(name){
  const s=String(name||'').replace(/[٠-٩]/g,d=>'٠١٢٣٤٥٦٧٨٩'.indexOf(d)).replace(/,/g,'.');
  const m=s.match(/(\d+(?:\.\d+)?)\s*(كجم|كيلو|كج|kg|جم|جرام|غ|gm|g)(?![a-z])/i);
  if(!m)return null;let v=parseFloat(m[1]);if(/^(كجم|كيلو|كج|kg)$/i.test(m[2]))v*=1000;const u2=s.slice(m.index+m[0].length).match(/^\s*\+\s*(\d+(?:\.\d+)?)\s*(كجم|كيلو|كج|kg|جم|جرام|غ|gm|g)(?![a-z])/i);if(u2){let a=parseFloat(u2[1]);if(/^(كجم|كيلو|كج|kg)$/i.test(u2[2]))a*=1000;v+=a}return v}
function wOK(i){if(S.wc==='all')return true;const w=wOf(i.name);if(w==null)return false;return S.wc==='small'?w<=S.wcut:w>S.wcut}
function renderPick(){
  const q=norm($('#q').value.trim()),tr=new Set(S.tracked);
  const L=allItems().filter(i=>wOK(i)&&(!q||norm(i.code).includes(q)||norm(i.name).includes(q)));
  window._vis=L;
  $('#list').innerHTML=L.length?L.slice(0,400).map(i=>{const w=wOf(i.name);return `<label><input type="checkbox" data-c="${esc(i.code)}" ${tr.has(i.code)?'checked':''}><b>${esc(i.code)}</b><span>${esc(i.name)}</span><small class="z" style="margin-inline-start:auto">${w==null?'':fmt(w)+' جم'}</small></label>`}).join(''):'<div class="empty">'+(S.files.length?'مفيش أصناف بالفلتر ده':'ارفع تقرير الأول')+'</div>';
  $('#cnt').textContent=`${S.tracked.length} صنف مختار · ${L.length} ظاهر`;
  $('#chips').innerHTML=S.tracked.map(c=>`<span class="chip" data-rm="${esc(c)}">${esc(c)} ✕</span>`).join('');
}
function build(key){
  const r=build0(key);
  if(S.wmerge!=='no'){
    const g=new Map();
    r.cols.forEach((c,i)=>{const w=wOf(c.name),k=w==null?'i'+i:'w'+w;let o=g.get(k);if(!o){o={idx:[]};g.set(k,o)}o.idx.push(i)});
    const mc=[];
    g.forEach(o=>{
      const tot=o.idx.map(i=>r.rows.reduce((a,x)=>a+x.v[i],0));
      const best=o.idx[tot.indexOf(Math.max(...tot))];
      mc.push({code:o.idx.map(i=>r.cols[i].code).join('+'),name:r.cols[best].name,idx:o.idx})});
    r.rows.forEach(x=>{x.v=mc.map(m=>m.idx.reduce((a,i)=>a+x.v[i],0))});
    r.cols=mc;
  }
  const n=r.cols.length,idx=[...Array(n).keys()];
  if(S.wsort!=='none'){const W=r.cols.map(c=>wOf(c.name)),d=S.wsort==='desc'?-1:1;
    idx.sort((a,b)=>{const x=W[a],y=W[b];if(x==null&&y==null)return a-b;if(x==null)return 1;if(y==null)return -1;return(x-y)*d||a-b})}
  r.cols=idx.map(i=>r.cols[i]);r.rows.forEach(o=>{o.v=idx.map(i=>o.v[i])});return r}
$('#addp').onclick=()=>{
  const toks=$('#paste').value.split(/[\n,;،\t]+/).map(s=>s.trim()).filter(Boolean),items=allItems(),nf=[];
  toks.forEach(t=>{let hit=items.filter(i=>i.code===t);
    if(!hit.length){const n=norm(t);hit=items.filter(i=>wOK(i)&&norm(i.name).includes(n))}
    if(!hit.length)nf.push(t);hit.forEach(h=>{if(!S.tracked.includes(h.code))S.tracked.push(h.code)})});
  $('#nf').textContent=nf.length?'مش لاقي: '+nf.join(' ، '):'';if(!items.length)toast('ارفع تقرير الأول');
  $('#paste').value='';renderPick();renderOut();save()};
$('#wc').onchange=e=>{S.wc=e.target.value;renderPick();save()};
$('#wcut').oninput=e=>{S.wcut=+e.target.value||360;renderPick();save()};
$('#wsort').onchange=e=>{S.wsort=e.target.value;renderOut();save()};
load();if(!['tot','name','orig'].includes(S.mode))S.mode='tot';
if(!['all','small','large'].includes(S.wc))S.wc='all';if(!S.wcut)S.wcut=360;if(!['desc','asc','none'].includes(S.wsort))S.wsort='desc';
if(S.wmerge!=='no')S.wmerge='yes';
$('#wm').checked=S.wmerge==='yes';$('#wm').onchange=e=>{S.wmerge=e.target.checked?'yes':'no';renderOut();save()};
$('#wc').value=S.wc;$('#wcut').value=S.wcut;$('#wsort').value=S.wsort;
renderAll();
</script>
